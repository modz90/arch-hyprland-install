{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left":   ["custom/launcher", "mpris", "custom/weather"],
    "modules-center": ["clock", "hyprland/workspaces"],
    "modules-right":  ["pulseaudio", "network", "battery", "tray"],

    "custom/launcher": {
        "format": "",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": { "default": "▶", "mpv": "▶" },
        "status-icons": { "paused": "⏸" },
        "dynamic-len": 30,
        "dynamic-importance-order": ["title", "artist", "album"],
        "on-click": "playerctl play-pause"
    },

    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "interval": 1800,
        "format": "{}",
        "tooltip": false
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "hyprland/workspaces": {
        "format": "{id} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰣆",
        "window-rewrite": {
            "title<.*YouTube.*>": "󰿉",

            "class<firefox>": "󰈹",
            "class<chromium>": "󰊯",
            "class<brave-browser>": "󰖟",
            "class<google-chrome>": "󰊯",
            "class<vivaldi.*>": "󰖟",
            "class<tor browser>": "󰈹",

            "class<kitty>": "",
            "class<foot>": "",
            "class<alacritty>": "",
            "class<wezterm>": "",
            "class<org.wezfurlong.wezterm>": "",

            "class<code>|class<code-oss>": "󰨞",
            "class<visual-studio-code.*>": "󰨞",
            "class<cursor.*>": "󰨞",
            "class<neovide>": "",
            "class<nvim>": "",
            "class<emacs.*>": "",
            "class<sublime.*>": "",
            "class<jetbrains.*>": "󰫍",

            "class<thunar>": "󰉋",
            "class<dolphin>": "󰉋",
            "class<nautilus>": "󰉋",
            "class<nemo>": "󰉋",
            "class<pcmanfm.*>": "󰉋",

            "class<discord>": "󰙯",
            "class<vesktop>": "󰙯",
            "class<slack>": "󰒱",
            "class<telegram.*>|class<org.telegram.*>": "󰔁",
            "class<signal>": "󰍡",
            "class<thunderbird>": "󰇮",

            "class<spotify>": "󰓇",
            "class<mpv>": "󰎁",
            "class<vlc>": "󰕼",
            "class<rhythmbox>": "󰓃",
            "class<cava>": "󰝚",
            "class<audacity>": "󰗅",

            "class<steam>": "󰓓",
            "class<lutris>": "󰺵",
            "class<heroic>": "󰺵",
            "class<minecraft.*>": "󰍳",
            "class<prismlauncher>": "󰍳",

            "class<obsidian>": "󰎚",
            "class<zathura>": "󰈦",
            "class<evince>": "󰈦",
            "class<libreoffice.*>": "󰈙",
            "class<soffice>": "󰈙",

            "class<gimp.*>": "󰏘",
            "class<inkscape>": "󰕙",
            "class<blender>": "󰂫",
            "class<kdenlive>": "󰄱",
            "class<obs>": "󰻿",

            "class<pavucontrol.*>": "󰕾",
            "class<easyeffects>": "󰸎",
            "class<qalculate.*>": "󰃬",
            "class<nwg-displays>": "󰍹",
            "class<btop>": "󰨘",
            "class<.*hyprshot.*>": "󰹑",
            "class<swappy>": "󰹑",
            "class<songrec>": "󰽷"
        },
        "on-click": "activate"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol-qt"
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "󰖪 off",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": { "warning": 30, "critical": 15 }
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    }
}
